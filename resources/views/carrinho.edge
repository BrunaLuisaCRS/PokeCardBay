<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="../assets/css/style.css">
    <title>PokeCardBay - Carrinho</title>
</head>
<body class="full">
  <div class="page-container">
    
    <div class="header">
        <div class="form-heather-cadastro" style="padding: 20px; max-width: 1200px; margin: 0 auto; width: 100%;">
            <button onclick="window.location.href='/'" class="button" style="background-color: transparent; color: #a005be; border: 2px solid #a005be;">
                <i class="fas fa-home"></i> Voltar
            </button>
        </div>
      <div class="logo">
        <img src="https://media.criticalhit.net/2017/01/Pokemon-Hearthstone-header.jpg" alt="Logo da loja">
      </div>
    </div>

    <main class="cart-container ">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 20px;">
           <i class="fa-solid fa-cart-shopping" style="font-size: 1.5rem;"></i>
           <h2 style="margin: 0;">Meu Carrinho</h2>
        </div>

      @if(items.length === 0)
        <div style="text-align: center; width: 100%; padding: 40px; background: #fff; border-radius: 12px; margin-bottom: 20px;">
            <h3 style="color: #333;">Seu carrinho está vazio.</h3>
            <p style="color: #666;">Que tal adicionar algumas cartas raras?</p>
            <a href="/" style="display: inline-block; margin-top: 15px; color: #a005be; text-decoration: none; font-weight: bold; border: 1px solid #a005be; padding: 10px 20px; border-radius: 5px;">Ir às compras</a>
        </div>
      @else

      <section class="cart-items">
        
        @each(item in items)
           @if(item.marketCard)
            <div class="cart-item">
                <!-- Imagem: Tenta imageUrl, depois image, depois placeholder -->
                <img src="{{ item.marketCard.imageUrl || item.marketCard.image || 'https://via.placeholder.com/150' }}" alt="{{ item.marketCard.name }}">
                
                <div class="item-info">
                    <h3>{{ item.marketCard.name }}</h3>
                    <!-- REMOVIDO O ID DA CARTA, MANTENDO APENAS A RARIDADE -->
                    <p>{{ item.marketCard.rarity || 'Comum' }}</p>
                    
                    @if(item.marketCard.seller || item.marketCard.userName)
                        <p style="font-size: 0.9em; color: #666;">Vendedor: {{ item.marketCard.seller || item.marketCard.userName }}</p>
                    @endif

                    <!-- LÓGICA DE PREÇO ROBUSTA NA VIEW -->
                    <span class="price" style="font-size: 1.2rem; font-weight: bold; color: #28a745;">
                        @let(rawPrice = item.marketCard.price)
                        <!-- Remove R$, espaços e troca vírgula por ponto antes de converter -->
                        @let(priceString = String(rawPrice).replace('R$', '').trim().replace(',', '.'))
                        @let(finalPrice = Number(priceString))
                        
                        R$ {{ isNaN(finalPrice) ? '0,00' : finalPrice.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) }}
                    </span>
                    
                    <span style="font-size: 0.9rem; color: #555; margin-left: 10px;">
                        (Qtd: {{ item.quantity }})
                    </span>
                </div>
                
                <div class="item-controls" style="justify-content: flex-end;">
                    <form action="/carrinho/remove/{{ item.id }}" method="POST" style="display:inline;">
                        {{ csrfField() }}
                        <button type="submit" class="remove" title="Remover item" onclick="return confirm('Tem certeza que deseja remover este item?')" style="background: none; border: none; cursor: pointer; color: #dc3545;">
                            <i class="bi bi-trash3" style="font-size: 1.5rem;"></i>
                        </button>
                    </form>
                </div>
            </div>
           @endif
        @end
        
      </section>

      <aside class="cart-summary">
        <h3>Resumo</h3>
        <div class="summary-item">
          <span>Subtotal:</span>
          <span>R$ {{ subtotal.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) }}</span>
        </div>
        <div class="summary-item">
          <span>Frete:</span>
          <span>A Calcular</span>
        </div>
        <div class="summary-item total">
          <span>Total:</span>
          <span>R$ {{ subtotal.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) }}</span>
        </div>
        
        <!-- BOTÃO ATUALIZADO: Passa 'price' e 'count' (quantidade de itens únicos) na URL -->
        <button onclick="window.location.href='/compra?price={{ subtotal }}&count={{ items.length }}'" class="button">Finalizar Compra</button>
      </aside>

      @endif

    </main>
  </div>
</body>
</html>