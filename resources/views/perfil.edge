<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
    <link rel="stylesheet" href="../assets/css/style.css">
    <title>PokeCardBay - Perfil</title>
</head>

<body class="full">
    <div class="page-container">
        
        <div class="header">
            <div class="logo">
                <img src="https://media.criticalhit.net/2017/01/Pokemon-Hearthstone-header.jpg" alt="Logo da loja">
            </div>
        </div>

        <main class="perfil-container">
            <h2>Minha Conta</h2>

            <div class="layout">
                <section class="checkout-form">
                    <div class="perfil-info">
                        <div class="perfil-avatar">
                            <img src="{{ user.photoUrl || 'https://i.pinimg.com/236x/65/72/3e/65723edbdc8e9113741475429e5845af.jpg' }}" alt="Foto do Perfil">
                        </div>
                        <h3>{{ user.full_name }}</h3>
                        <p>{{ user.email }}</p>
                    </div>

                    <div class="infos-user">
                        <!-- FORM DE ATUALIZAÇÃO DE PERFIL -->
                        <form id="form-perfil" action="/perfil/update" method="POST" enctype="multipart/form-data">
                            {{ csrfField() }}
                            <h2 style="font-size: 1.5rem; margin-bottom: 15px;">Atualizar Perfil</h2>
                            <div id="imput-group">
                                <div class="imput-box">
                                    <label for="full_name">Nome</label>
                                    <i class="fas fa-user"></i>
                                    <input id="full_name" type="text" name="full_name" value="{{ user.full_name }}">
                                </div>
                                <div class="imput-box">
                                    <label for="photo">Foto de Perfil</label>
                                    <i class="fas fa-camera"></i>
                                    <input id="photo" type="file" name="photo" accept="image/*">
                                </div>
                                <button type="submit" class="buttonsmit">
                                    <i class="fas fa-save"></i> Salvar Perfil
                                </button>
                            </div>
                        </form>

                        <!-- FORM DE ALTERAÇÃO DE SENHA -->
                        <form id="form-senha" action="/perfil/password" method="POST">
                            {{ csrfField() }}
                            <h2 style="font-size: 1.5rem; margin-bottom: 15px;">Alterar Senha</h2>
                            <div id="imput-group">
                                <div class="imput-box">
                                    <label for="senha-atual">Senha Atual</label>
                                    <i class="fas fa-lock"></i>
                                    <input id="senha-atual" type="password" name="senha-atual" required>
                                </div>
                                <div class="imput-box">
                                    <label for="senha-nova">Nova Senha</label>
                                    <i class="fas fa-key"></i>
                                    <input id="senha-nova" type="password" name="senha-nova" required>
                                </div>
                                <button type="submit" class="buttonsmit">
                                    <i class="fas fa-save"></i> Salvar Nova Senha
                                </button>
                            </div>
                        </form>

                        <!-- 👉 Botão para voltar à Home -->
                        <a href="/" class="button" style="text-decoration: none; display: inline-flex; align-items: center; gap: 8px; margin-top: 20px;">
                            <i class="fas fa-home"></i> Home
                        </a>

                        <!-- 👉 Botão de Logout -->
                        <form action="/logout" method="POST" style="margin-top: 10px;">
                            {{ csrfField() }}
                            <button type="submit" class="button" style="display: inline-flex; align-items: center; gap: 8px;">
                                <i class="fas fa-sign-out-alt"></i> Logout
                            </button>
                        </form>

                    </div>
                </section>

                <aside class="cart-summary">
                    <h3>Minhas Cartas à Venda</h3>

                    @if(cards.length === 0)
                        <p>Você ainda não anunciou nenhuma carta.</p>
                    @else
                        @each(card in cards)
                            <div class="item-venda">
                                <img src="{{ card.imageUrl }}" alt="{{ card.name }}">
                                <div class="item-venda-info">
                                    <p>{{ card.name }} {{ card.cardApiId }}</p>
                                    <span>R$ {{ card.price }}</span>
                                </div>
                                <button class="btn-editar-venda"><i class="fas fa-pen"></i></button>
                            </div>
                        @endeach
                    @endif

                    <a href="/vender" class="button" style="text-decoration: none; justify-content: center; width: 100%; margin-top: 20px;">
                        <i class="fas fa-plus"></i> Anunciar Nova Carta
                    </a>
                </aside>

            </div>
        </main>
    </div>
</body>
</html>