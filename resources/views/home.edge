                    <button title="Carrinho" onclick="window.location.href='/carrinho'"><i class="fa-solid fa-cart-shopping"></i></button>
                </li>
                <li>
                    <button title="Home"><i class="fa-regular fa-house" onclick="window.location.href='/'"></i></button>
                </li>
                <li class="barra-pesquisa-container">
                  <form id="search-form" class="barra-pesquisa" role="search">
                    <label for="search-input" class="visually-hidden">Buscar Card:</label> <input type="text" id="search-input" placeholder="Digite o nome (ex: Pikachu)">
                    <button type="submit"><i class="fa-solid fa-search"></i></button>
                  </form>
                </li>
                <li>
