                </li>
                </ul>
            </nav>
        </header>

        <div id="results-container" style="display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; justify-content: center; padding: 20px;">
        </div>

        <div id="results-container" style="display: flex; flex-wrap: wrap; gap: 10px; ...">
        </div>

        <div id="pagination-controls" style="text-align: center; padding: 20px; display: none;">
        <button id="btn-prev">&laquo; Anterior</button>
        <span id="page-info" style="margin: 0 15px;">Página 1</span>
        <button id="btn-next">Próxima &raquo;</button>
        </div>

        <section class="showcase">
            </section>
        
        <!-- SHOWCASE DE CARTAS -->
        <section class="showcase">
        <h2>Cartas em Destaque</h2>

        <div class="swiper">
            <div class="swiper-wrapper">
            <!-- Slide 1 -->
                <div class="swiper-slide card">
                <img src="https://assets.pokemon.com/static-assets/content-assets/cms2/img/cards/web/SM11/SM11_EN_72.png" alt="Carta Reuniclus">
                <h3>Espeon GX</h3>
                <p>R$ 154,80</p>
                <button>Comprar</button>
            </div>
            <!-- Slide 2 -->
            <div class="swiper-slide card">
                <img src="https://assets.pokemon.com/static-assets/content-assets/cms2/img/cards/web/SV05/SV05_EN_171.png" alt="Carta Reuniclus">
                <h3>Reuniclus</h3>
                <p>R$ 54,80</p>
                <button>Comprar</button>
            </div>
            <!-- Slide 3 -->
            <div class="swiper-slide card">
                <img src="https://assets.pokemon.com/static-assets/content-assets/cms2/img/cards/web/SMP/SMP_EN_SM240.png" alt="Carta Espeon">
                <h3>Espeon GX</h3>
                <p>R$ 120,00</p>
                <button>Comprar</button>
            </div>
            <!-- Slide 4 -->
            <div class="swiper-slide card">
                <img src="https://copag.com.br/uploads/tinymce/c_SWSH11-234-1.png" alt="Carta Pikachu">
                <h3>Pikachu VMax</h3>
                <p>R$ 170,75</p>
                <button>Comprar</button>
            </div>
            <!-- Slide 5 -->
            <div class="swiper-slide card">
                <img src="https://assets.pokemon.com/static-assets/content-assets/cms2/img/cards/web/SM9/SM9_EN_165.png" alt="Carta Gengar">
                <h3>Gengar GX</h3>
                <p>R$ 2000,00</p>
                <button>Comprar</button>
            </div>

            <!-- Slide 6 -->
            <div class="swiper-slide card">
                <img src="https://assets.pokemon.com/static-assets/content-assets/cms2/img/cards/web/XY12/XY12_EN_11.png" alt="Carta Gengar">
                <h3>Charizard</h3>
                <p>R$ 50429,94</p>
                <button>Comprar</button>
            </div>

            <!-- Slide 7 -->
            <div class="swiper-slide card">
                <img src="https://assets.pokemon.com/static-assets/content-assets/cms2/img/cards/web/SV10/SV10_EN_232.png" alt="Carta Gengar">
                <h3>Cynthia's Gachomp</h3>
                <p>R$ 3250,23</p>
                <button>Comprar</button>
            </div>

            <!-- Slide 8 -->
            <div class="swiper-slide card">
                <img src="https://assets.pokemon.com/static-assets/content-assets/cms2/img/cards/web/ME01/ME01_EN_188.png" alt="Carta Gengar">
                <h3>Mega Lucario EX </h3>
                <p>R$ 52000,00</p>
                <button>Comprar</button>
            </div>
         
            </div>

            <!-- Botões de navegação -->
            <div class="swiper-button-next"></div>
            <div class="swiper-button-prev"></div>

            <!-- Paginação -->
            <div class="swiper-pagination"></div>
        </div>
        </section>

        
        <!-- FOOTER -->
        <footer class="footer">
            <p>&copy; 2025 PokeCardBay. Todos os direitos reservados.</p>
        </footer>

    </div>
        <!-- Swiper JS -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>
    <script>
    const swiper = new Swiper(".swiper", {
        slidesPerView: 1,
        spaceBetween: 20,
        loop: true,
        slidesPerGroup:1,
        navigation: {
        nextEl: ".swiper-button-next",
        prevEl: ".swiper-button-prev",
        },
        pagination: {
        el: ".swiper-pagination",
        clickable: true,
        },
        breakpoints: {
            640: {
                loop: true,         
                slidesPerGroup: 1,  
                slidesPerView: 2,
                spaceBetween: 15
            },
            900: {
                loop: true,         
                slidesPerGroup: 1,  
                slidesPerView: 3,
                spaceBetween: 20
            },
            1200: {
                loop: true,         
                slidesPerGroup: 1,  
                slidesPerView: 4,
                spaceBetween: 25
            },
            }
    });
    </script>

    // ++++++++++++++++++++ api cartinhas ++++++++++++++++++

    <script>
    // Pega os elementos do HTML
    const searchForm = document.getElementById('search-form');
    const searchInput = document.getElementById('search-input');
    const resultsContainer = document.getElementById('results-container');
    
    // Pega os NOVOS elementos da paginação
    const paginationControls = document.getElementById('pagination-controls');
    const btnPrev = document.getElementById('btn-prev');
    const btnNext = document.getElementById('btn-next');
    const pageInfo = document.getElementById('page-info');

    // --- Variáveis de Estado ---
    // Precisamos "lembrar" a busca atual e a página
    let currentQuery = '';
    let currentPage = 1;
    let totalCount = 0;
    const pageSize = 20; // O mesmo valor do seu controller!

    /**
     * Função REUTILIZÁVEL para buscar e mostrar os cards
     */
    async function fetchAndDisplayCards(query, page) {
      // Atualiza o estado
      currentQuery = query;
      currentPage = page;

      resultsContainer.innerHTML = 'Buscando...';
      paginationControls.style.display = 'none'; // Esconde os botões durante a busca

      try {
        // Chama a SUA API de backend (Adonis) com a PÁGINA
        const response = await fetch(`/api/search?q=${encodeURIComponent(query)}&page=${page}`);
        
        if (!response.ok) {
          throw new Error('Erro ao buscar');
        }

        const json = await response.json();
        
        resultsContainer.innerHTML = ''; // Limpa o "Buscando..."

        if (json.data && json.data.length > 0) {
          // Salva o total de resultados
          totalCount = json.totalCount; 
          
          json.data.forEach(card => {
            const img = document.createElement('img');
            img.src = card.images.small;
            img.alt = card.name;
            img.style.width = '150px';
            resultsContainer.appendChild(img);
          });
          
          // ATUALIZA E MOSTRA OS BOTÕES
          updatePaginationControls();

        } else {
          resultsContainer.innerHTML = 'Nenhum card encontrado.';
        }

      } catch (error) {
        console.error(error);
        resultsContainer.innerHTML = 'Falha ao carregar resultados.';
      }
    }

    /**
     * Função para ATUALIZAR os botões de paginação
     */
    function updatePaginationControls() {
      const totalPages = Math.ceil(totalCount / pageSize);

      // Atualiza o texto
      pageInfo.textContent = `Página ${currentPage} de ${totalPages}`;
      
      // Mostra os controles
      paginationControls.style.display = 'block';

      // Lógica dos botões "Anterior" e "Próximo"
      btnPrev.disabled = (currentPage === 1); // Desativa na página 1
      btnNext.disabled = (currentPage === totalPages); // Desativa na última página
    }

    // --- Eventos ---

    // 1. Evento do formulário de busca (Busca sempre a página 1)
    searchForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const query = searchInput.value.trim();
      if (query) {
        fetchAndDisplayCards(query, 1); // Inicia uma nova busca na página 1
      }
    });

    // 2. Evento do botão "Próxima"
    btnNext.addEventListener('click', () => {
      fetchAndDisplayCards(currentQuery, currentPage + 1);
    });

    // 3. Evento do botão "Anterior"
    btnPrev.addEventListener('click', () => {
      fetchAndDisplayCards(currentQuery, currentPage - 1);
    });

  </script>


</body>
</html>